{
  "packages": [
    "npm:pi-agent-browser-native",
    "npm:pi-mcp-adapter",
    "npm:pi-smart-fetch",
    "npm:pi-glance",
    "npm:@victor-software-house/pi-curated-themes",
    "npm:pi-subagents",
    "npm:pi-prompt-template-model",
    "npm:@eko24ive/pi-ask",
    "npm:@leonardorick/pi-web-search",
    "npm:pi-ollama-cloud",
    "npm:pi-working-vibe",
    "npm:@dietrichgebert/ponytail"
  ],
  "theme": "smyck",
  "powerline": "default",
  "transport": "sse",
  "defaultProvider": "opencode-go",
  "defaultModel": "deepseek-v4-pro",
  "defaultThinkingLevel": "max",
  "quietStartup": true,
  "enabledModels": [
    "opencode-go/deepseek-v4-flash",
    "opencode-go/deepseek-v4-pro",
    "opencode-go/glm-5.2",
    "opencode-go/kimi-k2.7-code",
    "opencode-go/minimax-m3",
    "opencode-go/qwen3.7-plus",
    "opencode-go/qwen3.7-max"
  ],
  "workingVibe": true,
  "workingVibeName": "startrek",
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "deepseek-v4-flash",
        "thinking": "xhigh"
      },
      "planner": {
        "model": "minimax-m3",
        "thinking": "xhigh"
      },
      "worker": {
        "model": "deepseek-v4-pro",
        "thinking": "xhigh"
      },
      "reviewer": {
        "model": "minimax-m3",
        "thinking": "xhigh"
      },
      "oracle": {
        "model": "deepseek-v4-pro",
        "thinking": "xhigh"
      },
      "context-builder": {
        "model": "deepseek-v4-flash",
        "thinking": "xhigh"
      },
      "researcher": {
        "model": "deepseek-v4-flash",
        "thinking": "xhigh"
      },
      "delegate": {
        "model": "kimi-k2.7-code",
        "thinking": "xhigh"
      }
    }
  },
  "lastChangelogVersion": "0.80.6",
  "terminal": {
    "imageWidthCells": 120
  }
}
